{
  "name": "clean-architecture-reference",
  "version": "1.0.0",
  "description": "A pragmatic Clean Architecture reference implementation with Node.js, Express, TypeScript, tsx, and esbuild",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/verify.ts"
  },
  "keywords": [
    "clean-architecture",
    "express",
    "typescript",
    "tsx",
    "esbuild",
    "crud"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
