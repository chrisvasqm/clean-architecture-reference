{
  "name": "clean-architecture-reference",
  "version": "1.0.0",
  "description": "A pragmatic Clean Architecture reference implementation with Node.js, Express, TypeScript, tsx, and esbuild",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "clean-architecture",
    "express",
    "typescript",
    "tsx",
    "esbuild",
    "crud"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.2",
    "moq.ts": "10.0.8",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
